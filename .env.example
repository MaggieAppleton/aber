# Copy to .env in the repository root. Never commit API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
AGENT_MODE=live
DAILY_SPEND_CAP_USD=5
ABER_DATA_DIR=
# Optional: read an existing .env file without copying secrets into a worktree.
# An explicitly selected missing file is an error. Exported variables take precedence.
ABER_ENV_FILE=
# Optional global override (off/shadow/on); job-specific flags take precedence.
# Leave unset/commented to use the job defaults below.
# JEV_MODE=off
JEV_LINK_EVIDENCE_MODE=on
JEV_TRIPWIRE_MODE=on
JEV_NEAR_DUP_MODE=off
JEV_PROCESS_DUMP_MODE=on
JEV_CHAT_MODE=on
# Thresholds require a pinned version; aliases such as jev-latest are rejected.
JEV_MODEL=jev-1.14.0
