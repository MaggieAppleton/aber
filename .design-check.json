        "height": 820
      },
      "max_nodes": 450,
      "targets": [
        {
          "selector": ".cur-index a",
          "row": true
        },
        {
          "selector": ".cur-theme-btn",
          "row": true
        }
      ],
      "assertions": [
        {
          "selector": ".ab-error",
          "condition": "absent"
        }
      ]
    },
    {
      "id": "columns-rest",
      "state": "rest",
